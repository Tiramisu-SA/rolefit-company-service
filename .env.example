PORT=3008
HOST=127.0.0.1
# For a LOCAL Postgres you run yourself (the gateway compose does not publish Postgres to the host;
# inside compose the URL is postgresql://company:company-local@postgres:5432/rolefit_company).
DATABASE_URL=postgresql://company:company-local@localhost:5432/rolefit_company
DATABASE_SSL=false
# DATABASE_CA_FILE=/absolute/path/to/provider-ca.pem
